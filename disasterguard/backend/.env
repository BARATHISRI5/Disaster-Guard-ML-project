# DisasterGuard Environment Variables

# ==========================================
# MODE CONTROL
# ==========================================
# Set to True for hackathon demo (no API keys needed)
USE_MOCK_DATA=True

# ==========================================
# Google Earth Engine
# ==========================================
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# ==========================================
# Twilio SMS Alerts
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_RECIPIENTS=+911234567890,+910987654321

# ==========================================
# Firebase Cloud Messaging
# ==========================================
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# ==========================================
# Server Config
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Model Paths
# ==========================================
CNN_MODEL_PATH=models/flood_cnn_model.h5
LSTM_MODEL_PATH=models/flood_lstm_model.pt
